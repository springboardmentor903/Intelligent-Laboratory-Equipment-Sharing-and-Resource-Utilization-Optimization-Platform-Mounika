# Git ignore for Lab Resource Utilization Platform
# --------------------------------------------------

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment and Secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.local
.env.*.local
*.pem
*.key
application-secrets.yml
application-local.yml

# IDE & Editor files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Java / Spring Boot Build Artifacts
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear

# Node / React Build Artifacts
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Upload storage
data/
uploads/
*.db

# Local Mentor Review Documentation (kept locally only)
docs/
