# ==============================================================================
# Environment Configuration Template (Example)
# Copy this file to .env or set environment variables in your deployment environment.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Server Port
PORT=8080

# Database Configuration (Optional: defaults to in-memory H2 if not set)
# For local PostgreSQL:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lab_resource_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_secure_password

# JWT Security Configuration
# Minimum 256-bit (32 character) secret key for HMAC-SHA256 signature
JWT_SECRET=your_custom_256_bit_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRATION_MS=86400000

# File Storage Directory
STORAGE_UPLOAD_DIR=./uploads

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
